# Shared AWS-compatible configuration
AWS_DEFAULT_REGION=eu-west-2
AWS_ENDPOINT_URL=http://floci:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
AWS_CONNECT_TIMEOUT_SECONDS=2
AWS_TIMEOUT_SECONDS=10
AWS_MAX_RETRIES=3

# S3
AWS_BUCKET=myapp-local
AWS_USE_PATH_STYLE_ENDPOINT=true

# Logical cloud resources
AWS_SQS_DEFAULT_QUEUE=myapp-default
AWS_SNS_DEFAULT_TOPIC=myapp-events
AWS_EVENT_BUS=default
AWS_DYNAMODB_DEFAULT_TABLE=myapp-documents
AWS_SECRET_DEFAULT=myapp/default
AWS_LAMBDA_DEFAULT_FUNCTION=myapp-default
